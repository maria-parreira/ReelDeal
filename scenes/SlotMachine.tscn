[sub_resource type="Shader" id=13]
code = "shader_type canvas_item;

void fragment() {
    // Cor do topo (azul)
    vec4 top_color = vec4(0.2, 0.4, 0.8, 1.0); 
    // Cor do fundo (laranja)
    vec4 bottom_color = vec4(0.9, 0.5, 0.2, 1.0); 
    
    // Gradiente interpolado verticalmente
    COLOR = mix(top_color, bottom_color, UV.y);
}
"

